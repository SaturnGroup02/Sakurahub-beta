    local LocalPlayer = SH.LocalPlayer
    local ReplicatedStorage = SH.ReplicatedStorage
    local RunService = SH.RunService
    local PlayActionSound = PlayActionSound

    local Tab = Window:Tab({ Title = "セレクトKick", Icon = "lucide:footprints" })

    local kickLoopEnabled = false
    local selectedKickPlayer = nil

    local function getPlayerTable()
        local players = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                table.insert(players, player.Name)
            end
        end
        return players
    end

    Tab:Paragraph({ Title = "👥 プレイヤー選択", Content = "キックする対象を選択します" })

    local playerDropdown = Tab:Dropdown({
        Title = "🎯 対象プレイヤー",
        Desc = "キックするプレイヤーを選択",
        Values = getPlayerTable(),
        Value = "",
        Callback = function(value)
            selectedKickPlayer = Players:FindFirstChild(value)
            PlayActionSound()
            WindUI:Notify({ Title = "プレイヤー選択", Content = "対象: " .. value, Duration = 2 })
        end,
    })

    Tab:Button({
        Title = "🔄 プレイヤー一覧更新",
        Icon = "lucide:refresh-cw",
        Callback = function()
            playerDropdown:SetValues(getPlayerTable())
            PlayActionSound()
            WindUI:Notify({ Title = "更新完了", Content = "プレイヤー一覧を更新しました", Duration = 1 })
        end,
    })

    Tab:Space()
    Tab:Paragraph({ Title = "⚡ メイン機能", Content = "ループキック (Blobシートが必要)" })

    local kickToggle = Tab:Toggle({
        Title = "🔄 ループキック (掴み + Blob)",
        Desc = "対象プレイヤーを連続キック",
        Value = false,
        Callback = function(on)
            kickLoopEnabled = on
            PlayActionSound()
            
            if on and not selectedKickPlayer then
                WindUI:Notify({ Title = "エラー", Content = "先にプレイヤーを選択してください", Icon = "lucide:x-circle", Duration = 3 })
                kickToggle:SetValue(false)
                return
            end
            
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local seat = hum and hum.SeatPart
            if on and (not seat or seat.Parent.Name ~= "CreatureBlobman") then
                WindUI:Notify({ Title = "エラー", Content = "Blobクリーチャーに座っている必要があります", Icon = "lucide:x-circle", Duration = 3 })
                kickToggle:SetValue(false)
                return
            end
            
            if not on then
                kickLoopEnabled = false
                WindUI:Notify({ Title = "ループキック", Content = "停止しました", Duration = 1.5 })
                return
            end

            WindUI:Notify({ Title = "ループキック", Content = "開始: " .. selectedKickPlayer.Name, Duration = 2 })

            task.spawn(function()
                local RS = ReplicatedStorage
                local GE = RS:WaitForChild("GrabEvents")
                local RunServiceLocal = RunService

                local blob = seat.Parent
                local blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
                local scriptObj = blob:FindFirstChild("BlobmanSeatAndOwnerScript")

                local CG = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
                local CD = scriptObj and scriptObj:FindFirstChild("CreatureDrop")

                local R_Det = blob:FindFirstChild("RightDetector")
                local R_Weld = R_Det and (R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld"))

                local SavedPos = blobRoot.CFrame

                local tChar = selectedKickPlayer.Character
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")

                if tRoot and blobRoot then
                    local bringStart = tick()
                    while tick() - bringStart < 0.35 do
                        if not kickLoopEnabled then break end
                        blobRoot.CFrame = tRoot.CFrame
                        blobRoot.Velocity = Vector3.zero
                        pcall(function()
                            if CG and R_Det then CG:FireServer(R_Det, tRoot, R_Weld) end
                            GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                            GE.SetNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
                        end)
                        RunServiceLocal.Heartbeat:Wait()
                    end
                    blobRoot.CFrame = SavedPos
                    blobRoot.Velocity = Vector3.zero
                    task.wait(0.05)
                end

                local packetTimer = 0

                while kickLoopEnabled do
                    if not selectedKickPlayer or not selectedKickPlayer.Parent or not selectedKickPlayer.Character then break end

                    tChar = selectedKickPlayer.Character
                    tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                    local tHum = tChar and tChar:FindFirstChild("Humanoid")

                    if tRoot and tHum and tHum.Health > 0 and blobRoot then
                        blobRoot.CFrame = SavedPos
                        blobRoot.Velocity = Vector3.zero
                        local lockPos = SavedPos * CFrame.new(0, 23, 0)
                        tRoot.CFrame = lockPos
                        tRoot.Velocity = Vector3.zero
                        tRoot.RotVelocity = Vector3.zero

                        if tick() - packetTimer > 0.05 then
                            packetTimer = tick()
                            pcall(function()
                                tHum.PlatformStand = true
                                tHum.Sit = true
                                GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                                if R_Det then
                                    local weld = R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld")
                                    if weld then CD:FireServer(weld) end
                                end
                                GE.DestroyGrabLine:FireServer(tRoot)
                                if R_Det then CG:FireServer(R_Det, tRoot, R_Weld) end
                                GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                            end)
                        end
                    else
                        blobRoot.CFrame = SavedPos
                        blobRoot.Velocity = Vector3.zero
                    end

                    if not kickLoopEnabled then break end
                    RunServiceLocal.Heartbeat:Wait()
                end

                kickLoopEnabled = false
                kickToggle:SetValue(false)

                if blobRoot then
                    blobRoot.CFrame = SavedPos
                    blobRoot.Velocity = Vector3.zero
                end

                WindUI:Notify({ Title = "ループキック", Content = "停止しました", Duration = 1.5 })
            end)
        end,
    })

    Tab:Space()
    Tab:Paragraph({ Title = "📊 ステータス", Content = "現在の状態" })
end

