do
    local WindUI = _G.WindUI
    local PlayActionSound = PlayActionSound
    local PlayErrorSound = PlayErrorSound

    function ExecuteExternalScript(url, label)
        local success, result = pcall(function()
            local code = game:HttpGet(url)
            if not code or #code == 0 then error("Empty response") end
            local func = loadstring(code)
            if not func then error("loadstring returned nil") end
            func()
        end)
        
        if success then
            print("✅ [" .. label .. "] Loaded successfully")
            PlayActionSound()
            WindUI:Notify({ Title = "✅ Success", Content = label .. " executed normally", Icon = "lucide:check-circle", Duration = 4 })
        else
            warn("❌ [" .. label .. "] Failed:", tostring(result))
            PlayErrorSound()
            WindUI:Notify({ Title = "❌ Failed", Content = label .. "\nError: " .. tostring(result):sub(1, 80), Icon = "lucide:x-circle", Duration = 5 })
        end
    end
end

