-- Toggle Wing V2
do
    local SH = _G.SH
    local Workspace = _G.SH.Workspace
    local LocalPlayer = _G.SH.LocalPlayer
    local RunService = _G.SH.RunService
    local WindUI = _G.WindUI
    local getPrimaryPart = _G.getPrimaryPart

    function toggleWing(state)
        SH.WingConfig.Enabled = state
        if state then
            if SH.FeatherConfig.Enabled then toggleFeather(false) end
            if SH.MagicCircleConfig.Enabled then toggleMagicCircle(false) end
            if SH.HeartConfig.Enabled then toggleHeart(false) end
            if SH.BigHeartConfig.Enabled then toggleBigHeart(false) end
