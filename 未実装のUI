do
    local LocalPlayer = _G.SH.LocalPlayer
    local ACTION_SOUND_ID = "rbxassetid://137505070991597"
    local ERROR_SOUND_ID = "rbxassetid://82845990304289"
    local OPEN_CLOSE_SOUND_ID = "rbxassetid://87437544236708"

    function PlaySound(id, volume)
        task.spawn(function()
            local sound = Instance.new("Sound")
            sound.SoundId = id
            sound.Volume = volume or 0.5
            sound.Parent = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui")
            sound:Play()
            sound.Ended:Wait()
            sound:Destroy()
        end)
    end

    function PlayActionSound() PlaySound(ACTION_SOUND_ID, 2.5) end
    function PlayErrorSound() PlaySound(ERROR_SOUND_ID, 5.0) end
    function PlayOpenCloseSound() PlaySound(OPEN_CLOSE_SOUND_ID, 10.0) end
end

